# waywall 데몬을 그래픽 세션과 함께 시작하는 systemd user 서비스 예제 (docs/setup.md#systemd-user-서비스-직접-설치).
#
# 설치 (직접 할 때만):
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/waywall.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now waywall.service
#
# home-manager를 쓰면 이 파일 대신 flake의 homeManagerModules.default(services.waywall.enable)를 쓴다.
# ExecStart는 nix profile 기준(~/.nix-profile/bin/waywall). 다르게 설치했으면 경로를 바꾼다.

[Unit]
Description=waywall live wallpaper daemon
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=%h/.nix-profile/bin/waywall daemon
# 비정상 종료 시에만 다시 시작한다. `waywall quit`으로 끝내면 그대로 둔다.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
